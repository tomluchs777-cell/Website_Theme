{% assign password_form_id = 'CinematicPasswordForm-' | append: section_id %}
{% form 'storefront_password', id: password_form_id, class: 'ts-password-form' %}
  <label for="CinematicPassword-{{ section_id }}">{{ 'placeholders.password' | t }}</label>
  <div class="ts-password-form__fields">
    <input
      id="CinematicPassword-{{ section_id }}"
      type="password"
      name="password"
      autocomplete="current-password"
      required
      {% if form.errors %}
        aria-invalid="true"
        aria-describedby="CinematicPasswordError-{{ section_id }}"
        autofocus
      {% endif %}
    >
    <button type="submit">{{ 'actions.submit' | t }}</button>
  </div>
  {% if form.errors %}
    <p id="CinematicPasswordError-{{ section_id }}" class="ts-password-form__error" role="alert">
      {{ 'content.wrong_password' | t }}
    </p>
  {% endif %}
{% endform %}

{% stylesheet %}
  .ts-password-form {
    width: min(100%, 380px);
    margin: 28px auto 0;
    text-align: left;
    color: #fff;
  }

  .ts-password-form label {
    display: block;
    margin-bottom: 8px;
    font-size: 13px;
    letter-spacing: .06em;
  }

  .ts-password-form__fields {
    display: flex;
    gap: 8px;
  }

  .ts-password-form input {
    width: 100%;
    min-width: 0;
    min-height: 48px;
    border: 1px solid rgb(255 255 255 / 70%);
    border-radius: 0;
    background: rgb(0 0 0 / 65%);
    padding: 12px;
    color: #fff;
    font: inherit;
    font-size: 16px;
  }

  .ts-password-form button {
    flex-shrink: 0;
    min-height: 48px;
    padding: 12px 18px;
    border: 1px solid #fff;
    border-radius: 0;
    background: #fff;
    color: #000;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  .ts-password-form button:hover {
    background: #e8e8e8;
  }

  .ts-password-form :is(input, button):focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  .ts-password-form__error {
    padding: 10px 12px;
    background: rgb(0 0 0 / 80%);
    color: #fff;
    font-size: 14px;
  }

  @media (max-width: 360px) {
    .ts-password-form__fields {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% style %}
  #TSCinematicHero-{{ section_id }}.ts-cinematic-hero {
    height: auto;
    min-height: 100svh;
    min-height: 100dvh;
    display: flex;
  }

  #TSCinematicHero-{{ section_id }}.ts-cinematic-hero .ts-cinematic-hero__content {
    height: auto;
    min-height: inherit;
  }
{% endstyle %}
