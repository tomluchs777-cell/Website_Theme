      "default": "<p>Zwischen Idee, Material und Zeit entsteht Parfum mit Charakter.</p>"
    },
    {
      "type": "header",
      "content": "Landing – Schriftgrößen"
    },
    {
      "type": "range",
      "id": "hero_overline_size",
      "label": "Kleine Überschrift – Schriftgröße",
      "min": 8,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "hero_heading_size",
      "label": "Titel – Schriftgröße",
      "min": 32,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 88
