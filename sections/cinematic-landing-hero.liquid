{% comment %}
  TOM SCHILLER – Cinematic Landing Hero
  Fullscreen Video-Hero für die Startseite.

  - Desktop- und Mobile-Video separat
  - autoplay / muted / loop / playsinline
  - Fullscreen / Full-Bleed
  - optional Poster, Overlay, Logo, Claim, CTA, Scroll-Hinweis
  - Video wird außerhalb des Viewports pausiert
  - prefers-reduced-motion wird respektiert
{% endcomment %}

<section
  id="TSCinematicHero-{{ section.id }}"
  class="ts-cinematic-hero"
  data-ts-cinematic-hero
  style="
    --ts-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --ts-hero-overlay-color: {{ section.settings.overlay_color }};
    --ts-hero-text: {{ section.settings.text_color }};
    --ts-hero-height-desktop: {{ section.settings.height_desktop }};
    --ts-hero-height-mobile: {{ section.settings.height_mobile }};
    --ts-hero-content-max: {{ section.settings.content_max_width }}px;
    --ts-hero-desktop-x: {{ section.settings.desktop_position_x }}%;
    --ts-hero-desktop-y: {{ section.settings.desktop_position_y }}%;
    --ts-hero-mobile-x: {{ section.settings.mobile_position_x }}%;
    --ts-hero-mobile-y: {{ section.settings.mobile_position_y }}%;
  "
>
  <div class="ts-cinematic-hero__media" aria-hidden="true">
    {% if section.settings.poster_image != blank %}
      {{
        section.settings.poster_image
        | image_url: width: 2400
        | image_tag:
          class: 'ts-cinematic-hero__poster',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
    {% endif %}

    {% if section.settings.video_desktop != blank %}
      {{
        section.settings.video_desktop
        | video_tag:
          class: 'ts-cinematic-hero__video ts-cinematic-hero__video--desktop',
          autoplay: true,
          loop: false,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'auto',
          image_size: '2400x'
      }}
    {% endif %}

    {% if section.settings.video_mobile != blank %}
      {{
        section.settings.video_mobile
        | video_tag:
          class: 'ts-cinematic-hero__video ts-cinematic-hero__video--mobile',
          autoplay: true,
          loop: false,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'auto',
          image_size: '1200x'
      }}
    {% elsif section.settings.video_desktop != blank %}
      {{
        section.settings.video_desktop
        | video_tag:
          class: 'ts-cinematic-hero__video ts-cinematic-hero__video--mobile',
          autoplay: true,
          loop: false,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'auto',
          image_size: '1200x'
      }}
    {% endif %}

    <div class="ts-cinematic-hero__overlay"></div>
  </div>

  {% liquid
    assign has_content = false
    if request.page_type == 'password'
      assign has_content = true
    endif

    if section.settings.logo != blank
      assign has_content = true
    endif

    if section.settings.eyebrow != blank
      assign has_content = true
    endif

    if section.settings.heading != blank
      assign has_content = true
    endif

    if section.settings.text != blank
      assign has_content = true
    endif

    if section.settings.button_label != blank and section.settings.button_link != blank
      assign has_content = true
    endif
  %}

  {% if has_content %}
    <div
      class="
        ts-cinematic-hero__content
        ts-cinematic-hero__content--{{ section.settings.horizontal_alignment }}
        ts-cinematic-hero__content--v-{{ section.settings.vertical_alignment }}
      "
    >
      <div class="ts-cinematic-hero__content-inner">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 1200
            | image_tag:
              class: 'ts-cinematic-hero__logo',
              widths: '240, 360, 520, 720, 960, 1200',
              sizes: '(max-width: 749px) 70vw, 42vw',
              loading: 'eager',
              alt: section.settings.logo.alt
          }}
        {% endif %}

        {% if section.settings.eyebrow != blank %}
          <div class="ts-cinematic-hero__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}

        {% if request.page_type == 'password' %}
          {% render 'cinematic-password-form', section_id: section.id %}
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1 class="ts-cinematic-hero__heading">
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="ts-cinematic-hero__text">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <a
            href="{{ section.settings.button_link }}"
            class="ts-cinematic-hero__button"
          >
            <span>{{ section.settings.button_label }}</span>
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if section.settings.show_scroll_indicator and request.page_type != 'password' %}
    <button
      type="button"
      class="ts-cinematic-hero__scroll"
      data-ts-hero-scroll
      aria-label="{{ section.settings.scroll_text | escape }}"
    >
      <span>{{ section.settings.scroll_text }}</span>
      <span class="ts-cinematic-hero__scroll-line" aria-hidden="true"></span>
    </button>
  {% endif %}
</section>

<span
  class="ts-cinematic-hero__after-marker"
  data-ts-hero-after
  aria-hidden="true"
></span>

{% style %}
  .ts-cinematic-hero__after-marker[data-ts-hero-after] {
    display: block;
    width: 100%;
    height: 0;
    margin: 0;
    padding: 0;
    scroll-margin-top: 0;
    pointer-events: none;
  }

  #TSCinematicHero-{{ section.id }} {
    position: relative;
    width: 100vw;
    max-width: none;
    height: calc(var(--ts-hero-height-desktop) * 1svh);
    min-height: 520px;
    margin-right: calc(50% - 50vw);
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    isolation: isolate;
    color: var(--ts-hero-text);
    background: #000;
  }

  @supports (height: 100dvh) {
    #TSCinematicHero-{{ section.id }} {
      height: calc(var(--ts-hero-height-desktop) * 1dvh);
    }
  }

  @supports (width: 100dvw) {
    #TSCinematicHero-{{ section.id }} {
      width: 100dvw;
      margin-right: calc(50% - 50dvw);
      margin-left: calc(50% - 50dvw);
    }
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__media,
  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__poster,
  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__video,
  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__media {
    z-index: 0;
    overflow: hidden;
    background: #000;
  }

  /*
    Schwarze Rückfallebene direkt unter dem Video. Falls der Browser beim
    Seek für einen Frame keinen Videoframe liefern kann, darf niemals Grau
    durchscheinen.
  */
  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__media::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #000;
    pointer-events: none;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__poster,
  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__video {
    display: block;
    object-fit: cover;
    object-position: var(--ts-hero-desktop-x) var(--ts-hero-desktop-y);
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__poster {
    z-index: 0;
    background: #000;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__video {
    z-index: 1;
    opacity: 0;
    transform: scale(1.002);
    transition: opacity 700ms ease;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__video.is-ready {
    opacity: 1;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__overlay {
    z-index: 2;
    pointer-events: none;
    background: var(--ts-hero-overlay-color);
    opacity: var(--ts-hero-overlay);
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__video--mobile {
    display: none;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__content {
    position: relative;
    z-index: 3;
    display: flex;
    width: 100%;
    height: 100%;
    padding: clamp(24px, 4vw, 72px);
    pointer-events: none;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__content--left {
    justify-content: flex-start;
    text-align: left;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__content--center {
    justify-content: center;
    text-align: center;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__content--right {
    justify-content: flex-end;
    text-align: right;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__content--v-top {
    align-items: flex-start;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__content--v-center {
    align-items: center;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__content--v-bottom {
    align-items: flex-end;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__content-inner {
    width: 100%;
    max-width: var(--ts-hero-content-max);
    pointer-events: auto;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__logo {
    display: block;
    width: min({{ section.settings.logo_width_desktop }}vw, 760px);
    max-width: 100%;
    height: auto;
    margin-bottom: {{ section.settings.logo_bottom_spacing }}px;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__content--center .ts-cinematic-hero__logo {
    margin-right: auto;
    margin-left: auto;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__content--right .ts-cinematic-hero__logo {
    margin-left: auto;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__eyebrow {
    margin-bottom: .8rem;
    font-size: clamp(.68rem, .72vw, .84rem);
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__heading {
    margin: 0;
    color: inherit;
    font-family: var(--font-heading-family, serif);
    font-size: clamp(2.6rem, 5.2vw, 6.6rem);
    font-weight: 400;
    line-height: .98;
    letter-spacing: -.025em;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__text {
    max-width: 46rem;
    margin-top: 1.15rem;
    font-size: clamp(.95rem, 1.05vw, 1.22rem);
    line-height: 1.5;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__content--center .ts-cinematic-hero__text {
    margin-right: auto;
    margin-left: auto;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__content--right .ts-cinematic-hero__text {
    margin-left: auto;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__button {
    display: inline-flex;
    margin-top: 1.65rem;
    padding: .78rem 1.1rem;
    align-items: center;
    gap: .8rem;
    color: inherit;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: transparent;
    font-size: .78rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 260ms ease,
      color 260ms ease,
      transform 260ms cubic-bezier(.22, .72, .18, 1);
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__button:hover {
    transform: translateY(-2px);
    color: #000;
    background: #fff;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__scroll {
    position: absolute;
    z-index: 4;
    right: 50%;
    bottom: 22px;
    display: flex;
    transform: translateX(50%);
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    color: var(--ts-hero-text);
    border: 0;
    background: transparent;
    font: inherit;
    font-size: .62rem;
    font-weight: 500;
    letter-spacing: .16em;
    text-transform: uppercase;
    cursor: pointer;
    pointer-events: auto;
    touch-action: manipulation;
    appearance: none;
    -webkit-appearance: none;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__scroll:hover {
    opacity: .78;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__scroll:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 8px;
  }

  #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__scroll-line {
    display: block;
    width: 1px;
    height: 34px;
    background: currentColor;
    opacity: .8;
    transform-origin: top;
    animation: tsHeroScrollLine-{{ section.id }} 1.9s ease-in-out infinite;
  }

  @keyframes tsHeroScrollLine-{{ section.id }} {
    0%, 100% {
      transform: scaleY(.35);
      opacity: .35;
    }

    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @media screen and (max-width: 749px) {
    #TSCinematicHero-{{ section.id }} {
      height: calc(var(--ts-hero-height-mobile) * 1svh);
      min-height: 520px;
    }

    @supports (height: 100dvh) {
      #TSCinematicHero-{{ section.id }} {
        height: calc(var(--ts-hero-height-mobile) * 1dvh);
      }
    }

    #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__video--desktop {
      display: none;
    }

    #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__video--mobile {
      display: block;
    }

    #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__poster,
    #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__video {
      object-position: var(--ts-hero-mobile-x) var(--ts-hero-mobile-y);
    }

    #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__content {
      padding: 24px 20px 38px;
    }

    #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__logo {
      width: {{ section.settings.logo_width_mobile }}vw;
      max-width: 90vw;
    }

    #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__heading {
      font-size: clamp(2.25rem, 12vw, 4.2rem);
    }

    #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__text {
      max-width: 92vw;
      font-size: .94rem;
    }

    #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__scroll {
      bottom: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__video {
      display: none !important;
    }

    #TSCinematicHero-{{ section.id }} .ts-cinematic-hero__scroll-line {
      animation: none;
    }
  }
{% endstyle %}

<script>
  (() => {
    const section = document.getElementById('TSCinematicHero-{{ section.id }}');
    if (!section || section.dataset.initialized === 'true') return;
    section.dataset.initialized = 'true';

    const desktopVideo = section.querySelector('.ts-cinematic-hero__video--desktop');
    const mobileVideo = section.querySelector('.ts-cinematic-hero__video--mobile');
    const scrollButton = section.querySelector('[data-ts-hero-scroll]');
    const afterMarker = section.nextElementSibling?.matches('[data-ts-hero-after]')
      ? section.nextElementSibling
      : document.querySelector(
          '#shopify-section-{{ section.id }} [data-ts-hero-after]'
        );
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const isMobile = () => window.matchMedia('(max-width: 749px)').matches;

    /*
      Exakt bis hinter die Landingpage scrollen:
      Die Unterkante der Section wird an die Oberkante des Viewports gesetzt.
    */
    if (scrollButton) {
      let scrollTriggeredAt = 0;

      const scrollPastHero = (event) => {
        if (event) {
          event.preventDefault();
          event.stopPropagation();
        }

        const now = Date.now();
        if (now - scrollTriggeredAt < 250) return;
        scrollTriggeredAt = now;

        /*
          Der Marker sitzt exakt NACH der Landingpage.
          scrollIntoView scrollt automatisch den tatsächlich verwendeten
          Scroll-Container des Themes – egal ob window, main oder Wrapper.
        */
        if (afterMarker) {
          afterMarker.scrollIntoView({
            behavior: reducedMotion.matches ? 'auto' : 'smooth',
            block: 'start',
            inline: 'nearest'
          });
          return;
        }

        /*
          Fallback nur falls der Marker aus irgendeinem Grund fehlt.
        */
        const sectionTop =
          section.getBoundingClientRect().top +
          window.pageYOffset;

        window.scrollTo({
          top: Math.round(sectionTop + section.offsetHeight),
          left: 0,
          behavior: reducedMotion.matches ? 'auto' : 'smooth'
        });
      };

      /*
        Capture-Phase: selbst wenn Horizon/Desktop einen Klickhandler
        darüberlegt, bekommt unser Button das Ereignis zuerst.
      */
      scrollButton.addEventListener('click', scrollPastHero, true);
      scrollButton.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse') {
          scrollPastHero(event);
        }
      }, true);
    }

    const getActiveVideo = () => {
      return isMobile() ? mobileVideo : desktopVideo;
    };

    const prepareVideo = (video) => {
      if (!video) return;

      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.loop = false;

      /* Fest: 0,3 s am Anfang und 0,3 s am Ende auslassen. */
      const loopStartTrim = 0.3;
      const loopEndTrim = 0.3;

      let loopBusy = false;

      const getSafeStart = () => {
        if (!Number.isFinite(video.duration) || video.duration <= 0) return 0;

        return Math.min(
          loopStartTrim,
          Math.max(video.duration - loopEndTrim - 0.08, 0)
        );
      };

      const getSafeEnd = () => {
        if (!Number.isFinite(video.duration) || video.duration <= 0) return Infinity;

        return Math.max(
          video.duration - loopEndTrim,
          getSafeStart() + 0.08
        );
      };

      const positionAtCleanStart = () => {
        const startTime = getSafeStart();

        if (
          video.currentTime < startTime - 0.01 ||
          video.currentTime >= getSafeEnd()
        ) {
          try {
            video.currentTime = startTime;
          } catch (error) {}
        }
      };

      const restartLoop = () => {
        if (
          loopBusy ||
          !Number.isFinite(video.duration) ||
          video.duration <= 0 ||
          video.currentTime < getSafeEnd()
        ) {
          return;
        }

        loopBusy = true;

        try {
          video.currentTime = getSafeStart();

          const playPromise = video.play();
          if (playPromise && typeof playPromise.catch === 'function') {
            playPromise.catch(() => {});
          }
        } catch (error) {}

        window.setTimeout(() => {
          loopBusy = false;
        }, 80);
      };

      if (video.readyState >= 1) {
        positionAtCleanStart();
      } else {
        video.addEventListener('loadedmetadata', positionAtCleanStart, { once: true });
      }

      /*
        Kein Canvas, kein Freeze-Frame und kein zusätzlicher Overlay-Layer.
        Auf unterstützten Browsern wird framegenau geprüft, ansonsten über
        timeupdate. Das ist insbesondere auf Mobil deutlich schlanker.
      */
      if (typeof video.requestVideoFrameCallback === 'function') {
        const monitorFrame = () => {
          restartLoop();
          video.requestVideoFrameCallback(monitorFrame);
        };

        video.requestVideoFrameCallback(monitorFrame);
      } else {
        video.addEventListener('timeupdate', restartLoop);
      }

      video.addEventListener('ended', () => {
        try {
          video.currentTime = getSafeStart();

          const playPromise = video.play();
          if (playPromise && typeof playPromise.catch === 'function') {
            playPromise.catch(() => {});
          }
        } catch (error) {}
      });

      const reveal = () => {
        video.classList.add('is-ready');
      };

      if (video.readyState >= 2) {
        reveal();
      } else {
        video.addEventListener('loadeddata', reveal, { once: true });
        video.addEventListener('canplay', reveal, { once: true });
      }
    };

    [desktopVideo, mobileVideo].forEach(prepareVideo);

    const pauseInactiveVideos = (activeVideo) => {
      [desktopVideo, mobileVideo].forEach((video) => {
        if (!video || video === activeVideo) return;
        if (!video.paused) video.pause();
      });
    };

    const playActiveVideo = async () => {
      if (reducedMotion.matches) return;

      const activeVideo = getActiveVideo();
      if (!activeVideo) return;

      pauseInactiveVideos(activeVideo);

      try {
        activeVideo.muted = true;

        /*
          Falls der Browser das Video beim Pausieren genau am problematischen
          Ende stehen gelassen hat, vor dem erneuten Start auf den sauberen
          Anfang setzen.
        */
        const startTrim = 0.3;
        const endTrim = {{ section.settings.loop_end_trim | default: 0.3 | json }};

        if (
          Number.isFinite(activeVideo.duration) &&
          activeVideo.duration > 0 &&
          (
            activeVideo.currentTime >= activeVideo.duration - endTrim ||
            activeVideo.currentTime < startTrim - 0.01
          )
        ) {
          activeVideo.currentTime = Math.min(
            Math.max(startTrim, 0),
            Math.max(activeVideo.duration - endTrim - 0.08, 0)
          );
        }

        await activeVideo.play();
      } catch (error) {
        /* Wenn Autoplay blockiert wird, bleibt das Poster sichtbar. */
      }
    };

    const visibilityObserver = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];

        if (entry && entry.isIntersecting) {
          playActiveVideo();
        } else {
          [desktopVideo, mobileVideo].forEach((video) => {
            if (video && !video.paused) video.pause();
          });
        }
      },
      {
        threshold: 0.04
      }
    );

    visibilityObserver.observe(section);

    const mobileQuery = window.matchMedia('(max-width: 749px)');

    const handleViewportChange = () => {
      playActiveVideo();
    };

    if (typeof mobileQuery.addEventListener === 'function') {
      mobileQuery.addEventListener('change', handleViewportChange);
    } else if (typeof mobileQuery.addListener === 'function') {
      mobileQuery.addListener(handleViewportChange);
    }

    playActiveVideo();
  })();
</script>

{% schema %}
{
  "name": "Cinematic Landing Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video_desktop",
      "label": "Video Desktop"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Video Mobil",
      "info": "Optional. Wenn leer, wird das Desktop-Video auch mobil verwendet."
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster / Fallback-Bild"
    },
    {
