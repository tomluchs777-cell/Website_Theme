{% comment %}
  TOM SCHILLER – Produktseite 50/50 Editorial

  Bestehendes Produkt-Metafeld:
    custom.parfumname_schwarz

  Neue optionale Produkt-Metafelder für das Buybox-Logo:
    custom.buybox_logo_groesse      -> Ganze Zahl, Prozent
    custom.buybox_logo_horizontal   -> Ganze Zahl, px
    custom.buybox_logo_vertikal     -> Ganze Zahl, px

  Empfohlene neue Produkt-Metafelder:
    custom.charakter_keywords  -> Liste Einzeiliger Text
    custom.anlass              -> Liste Einzeiliger Text
    custom.jahreszeit          -> Liste Einzeiliger Text
    custom.duftreise           -> Mehrzeiliger Text
    custom.inhaltsstoffe       -> Rich Text / Mehrzeiliger Text / Textliste

  Desktop:
    - linke Hälfte: vertikal gestapelte Produktmedien, jedes Bild viewporthoch
    - rechte Hälfte: sticky bis zum Ende der linken Galerie
    - exakt 50 / 50

  Mobile:
    - Galerie horizontal swipebar
    - Buybox darunter, nicht sticky
{% endcomment %}

{% liquid
  assign ts_variant = product.selected_or_first_available_variant
  assign ts_product_form_id = 'TSProductEditorialForm-' | append: section.id

  assign ts_logo_value = product.metafields.custom.parfumname_schwarz.value
  assign ts_logo = ts_logo_value.preview_image | default: ts_logo_value

  assign ts_logo_size = product.metafields.custom.buybox_logo_groesse.value | default: section.settings.logo_width
  assign ts_logo_x = product.metafields.custom.buybox_logo_horizontal.value | default: 0
  assign ts_logo_y = product.metafields.custom.buybox_logo_vertikal.value | default: 0

  assign ts_keywords = product.metafields.custom.charakter_keywords.value
  assign ts_occasion = product.metafields.custom.anlass.value
  assign ts_season = product.metafields.custom.jahreszeit.value
  assign ts_journey = product.metafields.custom.duftreise.value
  assign ts_ingredients_metafield = product.metafields.custom.inhaltsstoffe
  assign ts_ingredients = ts_ingredients_metafield.value

  assign ts_sample_set_product = section.settings.sample_set_product
  assign ts_is_sample_set = false
  if ts_sample_set_product != blank and product.id == ts_sample_set_product.id
    assign ts_is_sample_set = true
  endif

  assign ts_sample_product_1 = section.settings.sample_product_1
  assign ts_sample_product_2 = section.settings.sample_product_2
  assign ts_sample_product_3 = section.settings.sample_product_3
%}

<section
  id="TSProductEditorial-{{ section.id }}"
  class="ts-product-editorial{% if ts_is_sample_set %} ts-product-editorial--sample-set{% endif %}"
  style="
    --ts-pe-bg: {{ section.settings.background_color }};
    --ts-pe-text: {{ section.settings.text_color }};
    --ts-pe-muted: {{ section.settings.muted_color }};
    --ts-pe-button-bg: {{ section.settings.button_background }};
    --ts-pe-button-text: {{ section.settings.button_text_color }};
    --ts-pe-header-height: {{ section.settings.header_height_fallback }}px;
    --ts-pe-panel-height: calc(100svh - var(--ts-pe-header-height));
    --ts-pe-logo-size: {{ ts_logo_size }}%;
    --ts-pe-logo-x: {{ ts_logo_x }}px;
    --ts-pe-logo-y: {{ ts_logo_y }}px;
    --ts-pe-logo-optical-x: -6%;
  "
>
  <div class="ts-product-editorial__layout">

    <div class="ts-product-editorial__gallery" data-ts-gallery>
      {% if product.media.size > 0 %}
        {% for media in product.media %}
          <div
            class="ts-product-editorial__media"
            data-ts-media
            data-index="{{ forloop.index0 }}"
          >
            {% case media.media_type %}
              {% when 'image' %}
                {{
                  media.preview_image
                  | image_url: width: 2200
                  | image_tag:
                    class: 'ts-product-editorial__image',
                    widths: '640, 900, 1200, 1500, 1800, 2200',
                    sizes: '(max-width: 989px) 100vw, 50vw',
                    loading: 'eager',
                    alt: media.alt | default: product.title
                }}

              {% when 'video' %}
                {{
                  media
                  | media_tag:
                    class: 'ts-product-editorial__video',
                    image_size: '1600x',
                    autoplay: false,
                    loop: true,
                    controls: true,
                    preload: 'metadata'
                }}

              {% when 'external_video' %}
                {{
                  media
                  | external_video_tag:
                    class: 'ts-product-editorial__video'
                }}

              {% when 'model' %}
                {{
                  media
                  | model_viewer_tag:
                    class: 'ts-product-editorial__model',
                    reveal: 'interaction',
                    toggleable: true
                }}

              {% else %}
                {{
                  media
                  | media_tag:
                    class: 'ts-product-editorial__generic'
                }}
            {% endcase %}
          </div>
        {% endfor %}
      {% else %}
        <div class="ts-product-editorial__media">
          {{ 'product-1' | placeholder_svg_tag: 'ts-product-editorial__placeholder' }}
        </div>
      {% endif %}

    </div>

    {% if product.media.size > 1 %}
      <div class="ts-product-editorial__mobile-dots" aria-label="Produktbilder">
        {% for media in product.media %}
          <button
            type="button"
            class="ts-product-editorial__dot{% if forloop.first %} is-active{% endif %}"
            data-ts-dot="{{ forloop.index0 }}"
            aria-label="Produktbild {{ forloop.index }} anzeigen"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}

    <aside class="ts-product-editorial__right">
      <div class="ts-product-editorial__panel">

        <div class="ts-product-editorial__top">
          {% if ts_logo != blank %}
            {{
              ts_logo
              | image_url: width: 1000
              | image_tag:
                class: 'ts-product-editorial__logo',
                widths: '260, 420, 600, 800, 1000',
                sizes: '(max-width: 989px) 65vw, 26vw',
                loading: 'eager',
                alt: product.title
            }}
          {% else %}
            <h1 class="ts-product-editorial__product-title">{{ product.title }}</h1>
          {% endif %}

          {% if ts_is_sample_set %}
            {% if section.settings.sample_set_subline != blank %}
              <div class="ts-product-editorial__keywords">
                {{ section.settings.sample_set_subline }}
              </div>
            {% endif %}
          {% elsif ts_keywords != blank %}
            <div class="ts-product-editorial__keywords">
              {% for keyword in ts_keywords %}
                <span>{{ keyword }}</span>
                {% unless forloop.last %}
                  <span class="ts-product-editorial__keyword-sep" aria-hidden="true">·</span>
                {% endunless %}
              {% endfor %}
            </div>
          {% elsif section.settings.fallback_keywords != blank %}
            <div class="ts-product-editorial__keywords">
              {{ section.settings.fallback_keywords }}
            </div>
          {% endif %}

          <div class="ts-product-editorial__purchase">
            <div class="ts-product-editorial__purchase-copy">
              <div class="ts-product-editorial__type">
                {{ section.settings.product_type }}

                {% if ts_is_sample_set %}
                  {% if section.settings.sample_set_volume != blank %}
                    <span class="ts-product-editorial__type-separator">–</span>
                    {{ section.settings.sample_set_volume }}
                  {% endif %}
                {% elsif section.settings.volume != blank %}
                  <span class="ts-product-editorial__type-separator">–</span>
                  {{ section.settings.volume }}
                {% endif %}
              </div>

              <div class="ts-product-editorial__price">
                {{ ts_variant.price | money }}
              </div>
            </div>

            {% form 'product', product, id: ts_product_form_id, class: 'ts-product-editorial__form' %}
              <input type="hidden" name="id" value="{{ ts_variant.id }}">
              <input type="hidden" name="quantity" value="1">

              <button
                class="ts-product-editorial__add"
                type="submit"
                name="add"
                {% unless ts_variant.available %}disabled{% endunless %}
              >
                {% if ts_variant.available %}
                  {{ section.settings.add_to_cart_text }}
                {% else %}
                  {{ section.settings.sold_out_text }}
                {% endif %}
              </button>
            {% endform %}
          </div>

        </div>

        <div class="ts-product-editorial__story">
          {% if ts_is_sample_set %}
            <div class="ts-product-editorial__sample-cards">
              {% for ts_sample_i in (1..3) %}
                {% liquid
                  case ts_sample_i
                    when 1
                      assign ts_sample_product = ts_sample_product_1
                      assign ts_sample_text = section.settings.sample_text_1
                    when 2
                      assign ts_sample_product = ts_sample_product_2
                      assign ts_sample_text = section.settings.sample_text_2
                    when 3
                      assign ts_sample_product = ts_sample_product_3
                      assign ts_sample_text = section.settings.sample_text_3
                  endcase

                  assign ts_sample_logo_value = blank
                  assign ts_sample_logo = blank
                  assign ts_sample_keywords = blank

                  if ts_sample_product != blank
                    assign ts_sample_logo_value = ts_sample_product.metafields.custom.parfumname_schwarz.value
                    assign ts_sample_logo = ts_sample_logo_value.preview_image | default: ts_sample_logo_value
                    assign ts_sample_keywords = ts_sample_product.metafields.custom.charakter_keywords.value
                  endif
                %}

                {% if ts_sample_product != blank %}
                  <a
                    href="{{ ts_sample_product.url }}"
                    class="ts-product-editorial__sample-card"
                    aria-label="{{ ts_sample_product.title | escape }} entdecken"
                  >
                    <div class="ts-product-editorial__sample-card-head">
                      <div class="ts-product-editorial__sample-brand">
                        {% if ts_sample_logo != blank %}
                          {{
                            ts_sample_logo
                            | image_url: width: 520
                            | image_tag:
                              class: 'ts-product-editorial__sample-logo',
                              widths: '180, 260, 360, 520',
                              sizes: '(max-width: 989px) 38vw, 13vw',
                              loading: 'lazy',
                              alt: ts_sample_product.title
                          }}
                        {% else %}
                          <div class="ts-product-editorial__sample-name">{{ ts_sample_product.title }}</div>
                        {% endif %}
                      </div>

                      <span class="ts-product-editorial__sample-arrow" aria-hidden="true">→</span>
                    </div>

                    {% if ts_sample_keywords != blank %}
                      <div class="ts-product-editorial__sample-keywords">
                        {% for keyword in ts_sample_keywords %}
                          <span>{{ keyword }}</span>
                          {% unless forloop.last %}
                            <span class="ts-product-editorial__sample-keyword-sep" aria-hidden="true">·</span>
                          {% endunless %}
                        {% endfor %}
                      </div>
                    {% endif %}

                    {% if ts_sample_text != blank %}
                      <div class="ts-product-editorial__sample-text">{{ ts_sample_text }}</div>
                    {% endif %}

                    <div class="ts-product-editorial__sample-link">
                      {{ section.settings.sample_link_text }} →
                    </div>
                  </a>
                {% elsif request.design_mode %}
                  <div class="ts-product-editorial__sample-card ts-product-editorial__sample-card--placeholder">
                    Duft {{ ts_sample_i }} auswählen
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}

          <div
            class="ts-product-editorial__accordions{% if ts_is_sample_set %} ts-product-editorial__accordions--sample{% endif %}"
            data-ts-accordions
          >
            {% unless ts_is_sample_set %}
              <div class="ts-product-editorial__accordion is-open" data-ts-accordion>
                <button
                  type="button"
                  class="ts-product-editorial__accordion-trigger"
                  data-ts-accordion-trigger
                  aria-expanded="true"
                >
                  <span>{{ section.settings.profile_title }}</span>
                  <span class="ts-product-editorial__accordion-icon" aria-hidden="true"></span>
                </button>

                <div class="ts-product-editorial__accordion-panel" data-ts-accordion-panel>
                  <div class="ts-product-editorial__accordion-inner">
                    <div class="ts-product-editorial__accordion-content ts-product-editorial__accordion-content--profile">
                      {% if ts_journey != blank or section.settings.fallback_journey != blank %}
                        <div class="ts-product-editorial__journey ts-product-editorial__journey--primary">
                          <div class="ts-product-editorial__journey-text">
                            {% if ts_journey != blank %}
                              {{ ts_journey | escape | newline_to_br }}
                            {% else %}
                              {{ section.settings.fallback_journey | escape | newline_to_br }}
                            {% endif %}
                          </div>
                        </div>
                      {% endif %}

                      <div class="ts-product-editorial__traits">
                        <div class="ts-product-editorial__trait ts-product-editorial__trait--left">
                          <div class="ts-product-editorial__trait-label">Anlass</div>
                          <div class="ts-product-editorial__trait-values">
                            {% if ts_occasion != blank %}
                              {% for item in ts_occasion %}
                                <span class="ts-product-editorial__trait-value">{{ item }}</span>
                                {% unless forloop.last %}
                                  <span class="ts-product-editorial__trait-separator" aria-hidden="true">·</span>
                                {% endunless %}
                              {% endfor %}
                            {% else %}
                              <span>{{ section.settings.fallback_occasion }}</span>
                            {% endif %}
                          </div>
                        </div>

                        <div class="ts-product-editorial__trait ts-product-editorial__trait--right">
                          <div class="ts-product-editorial__trait-label">Jahreszeit</div>
                          <div class="ts-product-editorial__trait-values">
                            {% if ts_season != blank %}
                              {% for item in ts_season %}
                                <span class="ts-product-editorial__trait-value">{{ item }}</span>
                                {% unless forloop.last %}
                                  <span class="ts-product-editorial__trait-separator" aria-hidden="true">·</span>
                                {% endunless %}
                              {% endfor %}
                            {% else %}
                              <span>{{ section.settings.fallback_season }}</span>
                            {% endif %}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {% endunless %}

            <div class="ts-product-editorial__accordion" data-ts-accordion>
              <button
                type="button"
                class="ts-product-editorial__accordion-trigger"
                data-ts-accordion-trigger
                aria-expanded="false"
              >
                <span>{{ section.settings.safety_title }}</span>
                <span class="ts-product-editorial__accordion-icon" aria-hidden="true"></span>
              </button>

              <div class="ts-product-editorial__accordion-panel" data-ts-accordion-panel>
                <div class="ts-product-editorial__accordion-inner">
                  <div class="ts-product-editorial__accordion-content">
                    <div class="ts-product-editorial__accordion-subsection">
                      <div class="ts-product-editorial__accordion-subtitle">
                        {{ section.settings.safety_subtitle }}
                      </div>
                      <div class="ts-product-editorial__accordion-copy rte">
                        {{ section.settings.safety_content }}
                      </div>
                    </div>

                    <div class="ts-product-editorial__accordion-subsection">
                      <div class="ts-product-editorial__accordion-subtitle">
                        {{ section.settings.ingredients_subtitle }}
                      </div>

                      <div class="ts-product-editorial__accordion-copy rte">
                        {% if ts_ingredients_metafield != blank %}
                          {% if ts_ingredients_metafield.type == 'rich_text_field' %}
                            {{ ts_ingredients_metafield | metafield_tag }}
                          {% elsif ts_ingredients_metafield.type contains 'list.' %}
                            <p>
                              {% for ingredient in ts_ingredients %}
                                {{ ingredient }}{% unless forloop.last %} · {% endunless %}
                              {% endfor %}
                            </p>
                          {% else %}
                            <p>{{ ts_ingredients | escape | newline_to_br }}</p>
                          {% endif %}
                        {% elsif section.settings.ingredients_fallback != blank %}
                          <p>{{ section.settings.ingredients_fallback | escape | newline_to_br }}</p>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="ts-product-editorial__accordion" data-ts-accordion>
              <button
                type="button"
                class="ts-product-editorial__accordion-trigger"
                data-ts-accordion-trigger
                aria-expanded="false"
              >
                <span>{{ section.settings.shipping_title }}</span>
                <span class="ts-product-editorial__accordion-icon" aria-hidden="true"></span>
              </button>

              <div class="ts-product-editorial__accordion-panel" data-ts-accordion-panel>
                <div class="ts-product-editorial__accordion-inner">
                  <div class="ts-product-editorial__accordion-content rte">
                    {{ section.settings.shipping_content }}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </aside>

  </div>
</section>

{% style %}
  #TSProductEditorial-{{ section.id }} {
    position: relative;
    width: 100vw;
    max-width: none;
    margin-right: calc(50% - 50vw);
    margin-left: calc(50% - 50vw);
    color: var(--ts-pe-text);
    background: var(--ts-pe-bg);
  }

  @supports (width: 100dvw) {
    #TSProductEditorial-{{ section.id }} {
      width: 100dvw;
      margin-right: calc(50% - 50dvw);
      margin-left: calc(50% - 50dvw);
    }
  }

  #TSProductEditorial-{{ section.id }} * {
    box-sizing: border-box;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__layout {
    display: grid;
    grid-template-columns: 50% 50%;
    width: 100%;
    max-width: none;
    align-items: start;
  }

  /* =========================
     LINKE GALERIE – DESKTOP
     ========================= */

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__gallery {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__media {
    position: relative;
    width: 100%;
    height: var(--ts-pe-panel-height);
    min-height: 0;
    overflow: hidden;
    background: #fff;
  }

  @supports (height: 100dvh) {
    #TSProductEditorial-{{ section.id }} {
      --ts-pe-panel-height: calc(100dvh - var(--ts-pe-header-height));
    }
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__image,
  #TSProductEditorial-{{ section.id }} .ts-product-editorial__video,
  #TSProductEditorial-{{ section.id }} .ts-product-editorial__model,
  #TSProductEditorial-{{ section.id }} .ts-product-editorial__generic {
    display: block;
    width: 100%;
    height: 100%;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__image {
    object-fit: {{ section.settings.image_fit }};
    object-position: center center;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__video,
  #TSProductEditorial-{{ section.id }} .ts-product-editorial__model {
    object-fit: cover;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__placeholder {
    width: 100%;
    height: 100%;
    opacity: .14;
  }

  /* =========================
     RECHTE HÄLFTE – STICKY
     Kein eigener Scrollcontainer:
     Wheel/Trackpad scrollt immer die Seite und damit die Galerie links.
     ========================= */

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__right {
    position: sticky;
    top: var(--ts-pe-header-height);
    width: 100%;
    height: var(--ts-pe-panel-height);
    min-height: 0;
    overflow: hidden;
    background: var(--ts-pe-bg);
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__panel {
    width: 100%;
    height: 100%;
    overflow: hidden;
    padding:
      {{ section.settings.panel_padding_top | times: 0.3 }}px
      {{ section.settings.panel_padding_horizontal }}px
      {{ section.settings.panel_padding_bottom }}px;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__top,
  #TSProductEditorial-{{ section.id }} .ts-product-editorial__story {
    width: 100%;
  }

  /* =========================
     BUYBOX
     ========================= */

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__logo {
    display: block;
    width: var(--ts-pe-logo-size);
    max-width: 100%;
    height: auto;
    object-fit: contain;
    object-position: left center;
    transform:
      translate(
        calc(var(--ts-pe-logo-optical-x) + var(--ts-pe-logo-x)),
        var(--ts-pe-logo-y)
      );
    transform-origin: left top;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__product-title {
    margin: 0;
    font-family: var(--font-heading-family, serif);
    font-size: clamp(2.7rem, 4vw, 5rem);
    font-weight: 400;
    line-height: .95;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__keywords {
    display: flex;
    flex-wrap: wrap;
    gap: .12rem .42rem;
    margin-top: .225rem;
    color: var(--ts-pe-muted);
    font-size: clamp(.78rem, .82vw, .92rem);
    letter-spacing: .035em;
    line-height: 1.35;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__keyword-sep {
    opacity: .45;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__purchase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(170px, 40%);
    gap: 1rem;
    align-items: stretch;
    margin-top: 1rem;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__purchase-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    gap: .55rem;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__type {
    font-size: clamp(.82rem, .88vw, .95rem);
    font-weight: 500;
    letter-spacing: .035em;
    text-transform: uppercase;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__type-separator {
    margin: 0 .22rem;
    opacity: .5;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__price {
    font-size: clamp(1.16rem, 1.2vw, 1.4rem);
    font-weight: 700;
    line-height: 1;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__form {
    display: flex;
    width: 100%;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__add {
    width: 100%;
    min-height: 64px;
    padding: .8rem 1rem;
    color: var(--ts-pe-button-text);
    border: 1px solid var(--ts-pe-button-bg);
    border-radius: {{ section.settings.button_radius }}px;
    background: var(--ts-pe-button-bg);
    font: inherit;
    font-size: .92rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__add:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__add:disabled {
    cursor: not-allowed;
    opacity: .55;
  }

  /* =========================
     PROBENSET
     ========================= */

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__sample-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: .7rem;
    width: 100%;
    margin-top: 0;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__sample-card {
    display: block;
    width: 100%;
    padding: .95rem 1rem;
    color: var(--ts-pe-text);
    border: 1px solid color-mix(in srgb, var(--ts-pe-text) 16%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--ts-pe-bg) 96%, var(--ts-pe-text) 4%);
    text-decoration: none;
    transition:
      transform 260ms cubic-bezier(.22, .72, .18, 1),
      background-color 260ms ease,
      border-color 260ms ease;
  }

  #TSProductEditorial-{{ section.id }} .ts-product-editorial__sample-card:hover {
    transform: translateY(-2px);
