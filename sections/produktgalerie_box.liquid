<script>
  (() => {
    const section = document.getElementById('TSProductEditorial-{{ section.id }}');
    if (!section || section.dataset.initialized === 'true') return;
    section.dataset.initialized = 'true';

    const gallery = section.querySelector('[data-ts-gallery]');
    const mediaItems = Array.from(section.querySelectorAll('[data-ts-media]'));
    const dots = Array.from(section.querySelectorAll('[data-ts-dot]'));
    const fallbackHeaderHeight = {{ section.settings.header_height_fallback | json }};

    let maxExpandedHeaderHeight = 0;
    let dotRaf = null;
    let resizeRaf = null;

    const getVisibleHeader = () => {
      const selectors = [
        '#header-component',
        'header-component',
        '.shopify-section-group-header-group',
        'header'
      ];

      for (const selector of selectors) {
        const candidates = Array.from(document.querySelectorAll(selector));

        for (const element of candidates) {
          const style = window.getComputedStyle(element);
          const rect = element.getBoundingClientRect();

          if (
            style.display !== 'none' &&
            style.visibility !== 'hidden' &&
            rect.width > window.innerWidth * 0.6 &&
            rect.height > 20 &&
            rect.height < 260
          ) {
            return element;
          }
        }
      }

      return null;
    };

    const syncHeaderHeight = (reset = false) => {
      if (!window.matchMedia('(min-width: 990px)').matches) return;

      if (reset) {
        maxExpandedHeaderHeight = 0;
      }

      const header = getVisibleHeader();
      const measured = header
        ? Math.round(header.getBoundingClientRect().height)
        : Number(fallbackHeaderHeight || 0);

      /*
        Bei einem später kompakter werdenden Sticky-Header behalten wir die
        größte gemessene Höhe. Damit entspricht die rechte Fläche weiterhin
        exakt der Höhe unter dem ausgefahrenen Header.
      */
      maxExpandedHeaderHeight = Math.max(
        maxExpandedHeaderHeight,
        measured,
        Number(fallbackHeaderHeight || 0)
      );

      section.style.setProperty(
        '--ts-pe-header-height',
        `${maxExpandedHeaderHeight}px`
      );
    };

    const syncDots = () => {
      if (!gallery || dots.length < 2 || mediaItems.length < 2) return;
      if (!window.matchMedia('(max-width: 989px)').matches) return;

      const scrollLeft = gallery.scrollLeft;
      let activeIndex = 0;
      let smallestDistance = Number.POSITIVE_INFINITY;

      mediaItems.forEach((media, index) => {
        const distance = Math.abs(media.offsetLeft - scrollLeft);

        if (distance < smallestDistance) {
          smallestDistance = distance;
          activeIndex = index;
        }
      });

      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === activeIndex;
        dot.classList.toggle('is-active', isActive);
        dot.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
    };

    if (gallery && dots.length > 1 && mediaItems.length > 1) {
      gallery.addEventListener(
        'scroll',
        () => {
          if (dotRaf) window.cancelAnimationFrame(dotRaf);
          dotRaf = window.requestAnimationFrame(syncDots);
        },
        { passive: true }
      );

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          const target = mediaItems[index];
          if (!target) return;

          gallery.scrollTo({
            left: target.offsetLeft,
            behavior: 'smooth'
          });
        });
      });
    }

    const handleResize = () => {
      if (resizeRaf) window.cancelAnimationFrame(resizeRaf);

      resizeRaf = window.requestAnimationFrame(() => {
        syncHeaderHeight(true);
        syncDots();
      });
    };

    window.addEventListener('resize', handleResize, { passive: true });

    /*
      Mehrfach messen, weil Horizon den Header nach dem ersten Paint noch
      layouten kann.
    */
    syncHeaderHeight(true);
    window.requestAnimationFrame(() => syncHeaderHeight());
    window.setTimeout(() => syncHeaderHeight(), 180);
    window.setTimeout(() => syncHeaderHeight(), 650);

    syncDots();

    const accordions = Array.from(section.querySelectorAll('[data-ts-accordion]'));

    accordions.forEach((accordion) => {
      const trigger = accordion.querySelector('[data-ts-accordion-trigger]');
      if (!trigger) return;

      trigger.addEventListener('click', () => {
        const willOpen = !accordion.classList.contains('is-open');

        /*
          Nur ein Feld darf gleichzeitig geöffnet sein.
          Beim Öffnen eines Feldes werden alle anderen zuerst geschlossen.
        */
        accordions.forEach((otherAccordion) => {
          const otherTrigger = otherAccordion.querySelector('[data-ts-accordion-trigger]');

          if (otherAccordion !== accordion) {
            otherAccordion.classList.remove('is-open');
            if (otherTrigger) {
              otherTrigger.setAttribute('aria-expanded', 'false');
            }
          }
        });

        accordion.classList.toggle('is-open', willOpen);
        trigger.setAttribute('aria-expanded', String(willOpen));
      });
    });
  })();
</script>

